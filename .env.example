# Copy to .env and generate your own SIGNATURE and AES_SECRET_KEY.
# SIGNATURE: python -c "import secrets; print(secrets.token_hex(32))"
# AES_SECRET_KEY: python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(16)).decode())"
SIGNATURE=
AES_SECRET_KEY=

PORT=8081

# true explicitly selects SQLite for local Agent demos.
# false uses DATABASE_URL. The MySQL database must already exist.
USE_SQLITE_FALLBACK=true
DATABASE_URL=mysql+aiomysql://medical_agent:change-me@localhost:3306/dao_c_demo?charset=utf8mb4

REDIS_URL=redis://localhost:6379/3
REDIS_KEY_PREFIX=dao_c
REDIS_SESSION_TTL_SECONDS=7200
REDIS_ASSET_TTL_SECONDS=86400
REDIS_CATEGORY_CACHE_TTL_SECONDS=600
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

DEEPSEEK_API_KEY=replace-with-your-api-key
SUPERVISOR_MODEL=deepseek-chat

# An independently deployed OpenAI-compatible specialist endpoint.
TCM_VLLM_BASE_URL=http://localhost:8000/v1
TCM_VLLM_API_KEY=EMPTY
TCM_MODEL_NAME=DeepSeek-R1-Acupuncture-32B-LoRA

# An independently deployed Streamable HTTP MCP server.
BRAIN_AD_MCP_URL=http://localhost:8101/mcp

# Optional. Defaults to storage/assets under the project directory.
# SHARED_ASSET_DIR=/absolute/path/to/shared/assets
MAX_HISTORY_TOKEN_BUDGET=3000
